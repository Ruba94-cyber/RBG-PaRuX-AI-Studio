PackageIdentifier: RBG.PaRuXAIStudio
PackageVersion: __VERSION__
MinimumOSVersion: 10.0.17763.0
InstallerType: wix
Scope: machine
InstallModes:
  - interactive
  - silent
  - silentWithProgress
UpgradeBehavior: install
# Quoted: an unquoted value starting with "{" is YAML flow-mapping syntax, not a string, so an
# unquoted MSI GUID here parses as an object instead of text and fails winget's schema validation.
ProductCode: "__PRODUCTCODE__"
# PaRuX keeps conversations, models, runtimes and paired-device credentials under
