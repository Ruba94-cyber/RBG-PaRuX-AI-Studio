    <!-- ======================================================================
         COMPONENT STYLES
         Border / TextBlock / Grid only - none of these types has a
         ControlTemplate, so a keyed Style can never blank them out.
         ====================================================================== -->

    <Style x:Key="PaRuXDisplayTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PaRuXDisplayFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource PaRuXFontSizeDisplay}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource PaRuXTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="PaRuXTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PaRuXDisplayFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource PaRuXFontSizeTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource PaRuXTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="PaRuXSubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PaRuXFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource PaRuXFontSizeSubtitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource PaRuXTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Small all-caps label that opens a group of settings or a list section. -->
    <Style x:Key="PaRuXSectionHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PaRuXFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource PaRuXFontSizeCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="60" />
        <Setter Property="Foreground" Value="{ThemeResource PaRuXTextTertiaryBrush}" />
    </Style>

    <Style x:Key="PaRuXBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PaRuXFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource PaRuXFontSizeBody}" />
        <Setter Property="Foreground" Value="{ThemeResource PaRuXTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="PaRuXBodyStrongTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PaRuXFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource PaRuXFontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource PaRuXTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- The description line under a setting, and other muted metadata. -->
    <Style x:Key="PaRuXCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PaRuXFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource PaRuXFontSizeCaption}" />
        <Setter Property="Foreground" Value="{ThemeResource PaRuXTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="PaRuXMicroTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PaRuXFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource PaRuXFontSizeMicro}" />
        <Setter Property="Foreground" Value="{ThemeResource PaRuXTextTertiaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Surfaces -->
    <Style x:Key="PaRuXCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource PaRuXSurfaceCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource PaRuXStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource PaRuXRadiusLarge}" />
        <Setter Property="Padding" Value="{StaticResource PaRuXCardPadding}" />
    </Style>

    <Style x:Key="PaRuXInsetCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource PaRuXSurfaceSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource PaRuXStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource PaRuXRadiusMedium}" />
        <Setter Property="Padding" Value="{StaticResource PaRuXCardPaddingTight}" />
    </Style>

    <Style x:Key="PaRuXDividerStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource PaRuXDividerBrush}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- Pills. Quiet = metadata (route badge). Accent = live/selected state. -->
    <Style x:Key="PaRuXQuietPillStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource PaRuXSurfaceSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource PaRuXStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource PaRuXRadiusPill}" />
        <Setter Property="Padding" Value="8,2,8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="PaRuXCautionPillStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource PaRuXCautionSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource PaRuXCautionBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource PaRuXRadiusPill}" />
        <Setter Property="Padding" Value="8,2,8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Segmented control shell that holds the AUTO / STANDARD / UNCENSORED toggles. -->
    <Style x:Key="PaRuXSegmentedShellStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource PaRuXSurfaceSubtleBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource PaRuXStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource PaRuXRadiusPill}" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- One row of a settings card: label block left, control right, even height. -->
    <Style x:Key="PaRuXSettingsRowStyle" TargetType="Grid">
        <Setter Property="MinHeight" Value="44" />
    </Style>

</ResourceDictionary>
