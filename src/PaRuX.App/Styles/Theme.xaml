    <!-- ======================================================================
         SCALE TOKENS  (theme independent)
         ====================================================================== -->

    <!-- Spacing. Layout rhythm - gaps between blocks, cards and sections - is
         always one of these. Optical padding inside a pill or between a label and
         its description drops to a 2px sub-step where 4 would look loose. -->
    <x:Double x:Key="PaRuXSpaceXS">4</x:Double>
    <x:Double x:Key="PaRuXSpaceS">8</x:Double>
    <x:Double x:Key="PaRuXSpaceM">12</x:Double>
    <x:Double x:Key="PaRuXSpaceL">16</x:Double>
    <x:Double x:Key="PaRuXSpaceXL">24</x:Double>
    <x:Double x:Key="PaRuXSpaceXXL">32</x:Double>
    <x:Double x:Key="PaRuXSpaceXXXL">48</x:Double>
    <x:Double x:Key="PaRuXSpaceXXXXL">64</x:Double>

    <Thickness x:Key="PaRuXCardPadding">16</Thickness>
    <Thickness x:Key="PaRuXCardPaddingTight">12</Thickness>

    <!-- Corner radius: 4 controls / 8 cards+bubbles / 12 panels / 16 composer / pill -->
    <CornerRadius x:Key="PaRuXRadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="PaRuXRadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="PaRuXRadiusLarge">12</CornerRadius>
