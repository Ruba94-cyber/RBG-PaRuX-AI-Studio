<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="PaRuX.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />

                <!-- PaRuX design tokens. Merged AFTER XamlControlsResources so the
                     brand overrides in it win over the stock Fluent values. -->
                <ResourceDictionary Source="ms-appx:///Styles/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                The five styles below are looked up FROM C# by key
                (ChatView.AppendMessageElement and MarkdownRenderer.BuildCodeBlock use
                Application.Current.Resources.TryGetValue). They therefore stay in this
                dictionary's own key set rather than moving into Styles\Theme.xaml, so
                the lookup never has to traverse a merged dictionary. Their VALUES are
                design tokens, so they still theme correctly.
                Do not rename these keys without updating the C# that reads them.
            -->

            <!-- Fenced code blocks inside assistant replies. -->
            <Style x:Key="PaRuXCodeBlockStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource PaRuXSurfaceCodeBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource PaRuXStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource PaRuXRadiusMedium}" />
                <Setter Property="Padding" Value="12" />
                <Setter Property="Margin" Value="0,8,0,12" />
            </Style>

            <!-- The user's own turn: right-aligned, accent-tinted, 8px radius with a
                 flattened corner on the side it is anchored to. -->
            <Style x:Key="PaRuXUserBubbleStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource PaRuXUserBubbleBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource PaRuXUserBubbleBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12,12,4,12" />
                <Setter Property="Padding" Value="12,8,12,8" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="MaxWidth" Value="560" />
            </Style>

            <!-- PaRuX's reply blends into the page, the way Claude and ChatGPT do it:
                 no box, no border, just typography and the avatar to its left. -->
            <Style x:Key="PaRuXAssistantBubbleStyle" TargetType="Border">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="{StaticResource PaRuXRadiusMedium}" />
                <Setter Property="Padding" Value="0,2,0,0" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="MaxWidth" Value="720" />
            </Style>

            <!-- A failed turn does get a box, because it needs to be unmissable. -->
            <Style x:Key="PaRuXErrorBubbleStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource PaRuXDangerSubtleBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource PaRuXDangerBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource PaRuXRadiusMedium}" />
                <Setter Property="Padding" Value="12" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="MaxWidth" Value="720" />
            </Style>

            <!-- Muted metadata caption. Now driven by the palette instead of Opacity,
                 so it keeps its contrast ratio in both themes. -->
            <Style x:Key="PaRuXSubtleCaptionStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource PaRuXFontFamily}" />
                <Setter Property="FontSize" Value="{StaticResource PaRuXFontSizeCaption}" />
                <Setter Property="Foreground" Value="{ThemeResource PaRuXTextSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
