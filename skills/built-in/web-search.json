{
  "id": "web-search",
  "name": "web-search",
  "displayName": "Web Search",
  "description": "A single keyless web search plus a top-result fetch, injected as untrusted context for the reply. Backed by PaRuX's existing chat-time web search integration.",
  "icon": "globe",
  "category": "Research",
  "version": "1.0.0",
  "author": "PaRuX",
  "source": "builtin",
  "license": "",
  "attribution": "",
  "enabled": true,
  "platforms": ["Windows", "Android"],
  "preferredModelRole": "MAIN_LLM",
  "allowedModelRoles": ["MAIN_LLM"],
  "requiredCapabilities": ["internet"],
  "allowedTools": ["web_search", "web_fetch", "browser_*"],
  "internetPolicy": "required",
  "memoryPolicy": "optional",
  "ragPolicy": "off",
  "slashCommand": "/web",
  "triggerExamples": ["cerca sul web", "search the web for", "cerca online"],
  "workflow": ["QUESTION", "SEARCH", "FETCH TOP RESULT", "LOCAL MODEL", "ANSWER"],
  "dependencies": ["WebSearchService"],
  "permissions": {
    "readFiles": false,
    "writeFiles": false,
    "deleteFiles": false,
    "shell": false,
    "network": true,
    "browser": true,
    "computerUse": false,
    "externalProcesses": false
  },
  "timeoutSeconds": 120,
  "retryPolicy": "none",
  "fallbackSkillId": "general",
  "confirmationPolicy": "never",
  "subSkillIds": []
}
