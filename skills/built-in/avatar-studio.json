{
  "id": "avatar-studio",
  "name": "avatar-studio",
  "displayName": "Avatar Studio",
  "description": "Digital-human avatar video from text, via a locally-configured AvatarProvider. Requires a private local engine (e.g. Duix) configured outside this repository - the public build ships this interface only, with no engine bundled or required.",
  "icon": "avatar",
  "category": "Media",
  "version": "1.0.0",
  "author": "PaRuX",
  "source": "builtin",
  "license": "",
  "attribution": "",
  "enabled": true,
  "platforms": ["Windows", "Android"],
  "preferredModelRole": "AVATAR",
  "allowedModelRoles": ["AVATAR"],
  "requiredCapabilities": ["avatar_provider"],
  "allowedTools": [],
  "internetPolicy": "off",
  "memoryPolicy": "off",
  "ragPolicy": "off",
  "slashCommand": "/avatar",
  "triggerExamples": ["crea un avatar che dice", "make an avatar say", "genera un video avatar"],
  "workflow": ["TEXT", "TTS", "LOCAL AVATAR PROVIDER", "VIDEO"],
  "dependencies": ["AvatarProviderService"],
  "permissions": { "readFiles": false, "writeFiles": false, "shell": false, "computerUse": false },
  "timeoutSeconds": 300,
  "retryPolicy": "none",
  "fallbackSkillId": "",
  "confirmationPolicy": "never",
  "subSkillIds": []
}
