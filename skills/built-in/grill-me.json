{
  "id": "grill-me",
  "name": "grill-me",
  "displayName": "Grill Me",
  "description": "Quizzes, interviews, or challenges you on a topic at a chosen difficulty and style. A pure prompt-shaping mode over the existing local chat pipeline - no new backend service.",
  "icon": "flame",
  "category": "Interactive",
  "version": "1.0.0",
  "author": "PaRuX",
  "source": "builtin",
  "license": "",
  "attribution": "",
  "enabled": true,
  "platforms": ["Windows", "Android"],
  "preferredModelRole": "MAIN_LLM",
  "allowedModelRoles": ["MAIN_LLM", "UNCENSORED_LLM"],
  "requiredCapabilities": [],
  "allowedTools": [],
  "internetPolicy": "off",
  "memoryPolicy": "optional",
  "ragPolicy": "optional",
  "slashCommand": "/grill",
  "triggerExamples": ["grill me on", "interrogami su", "quiz me on", "mettimi alla prova su"],
  "workflow": ["TOPIC + DIFFICULTY + STYLE", "LOCAL MODEL AS EXAMINER", "QUESTION", "USER ANSWER", "FEEDBACK", "NEXT QUESTION"],
  "dependencies": [],
  "permissions": { "readFiles": false, "writeFiles": false, "shell": false, "computerUse": false },
  "timeoutSeconds": 120,
  "retryPolicy": "none",
  "fallbackSkillId": "general",
  "confirmationPolicy": "never",
  "subSkillIds": [],
  "parameters": [
    { "name": "difficulty", "label": "Difficulty", "type": "select", "options": ["Easy", "Medium", "Hard", "Brutal"], "default": "Medium" },
    { "name": "style", "label": "Style", "type": "select", "options": ["Quiz", "Interview", "Socratic", "Challenge"], "default": "Quiz" },
    { "name": "questions", "label": "Questions", "type": "select", "options": ["Auto", "Custom"], "default": "Auto" }
  ]
}
